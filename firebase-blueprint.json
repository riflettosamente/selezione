{
  "entities": {
    "favorites": {
      "title": "User Favorites",
      "description": "Art, articles, and recommendations saved by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "createdAt"]
    },
    "daily_editions": {
      "title": "Daily Editions",
      "description": "Daily curated editorial editions saved step-by-step for 24h retention",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "status": { "type": "string" },
        "step": { "type": "string" },
        "currentStep": { "type": "number" },
        "totalSteps": { "type": "number" },
        "articles": { "type": "array" },
        "masterpiece": { "type": "object" },
        "book": { "type": "object" },
        "word": { "type": "object" },
        "quote": { "type": "object" },
        "completedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "syncedToFirestoreAt": { "type": "string" }
      },
      "required": ["date", "status"]
    }
  }
}
