{
  "entities": {
    "favorites": {
      "title": "User Favorites",
      "description": "Art, articles, and recommendations saved by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "createdAt"]
    },
    "daily_editions": {
      "title": "Daily Editions",
      "description": "Daily curated editorial editions saved permanently to prevent token re-generation",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "status": { "type": "string" },
        "articles": { "type": "array" },
        "artwork": { "type": "object" },
        "quote": { "type": "object" },
        "toc": { "type": "array" },
        "completedAt": { "type": "string" },
        "syncedToFirestoreAt": { "type": "string" }
      },
      "required": ["date", "status"]
    }
  }
}
