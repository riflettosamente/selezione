# GEMINI_API_KEY: Key for Google Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Free API key from console.groq.com (0 Google tokens used).
GROQ_API_KEY=
# GROQ_MODEL: Optional custom model on Groq (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# OPENROUTER_API_KEY: Free API key from openrouter.ai (0 Google tokens used).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL: Optional model on OpenRouter (default: meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# AI_PROVIDER: "groq" | "openrouter" | "gemini" | "auto" (default: auto - prioritizes Groq or OpenRouter if keys are provided)
AI_PROVIDER=auto

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Workspace OAuth Client ID (optional if using client-side GIS or direct Sheets URL)
GOOGLE_CLIENT_ID=

